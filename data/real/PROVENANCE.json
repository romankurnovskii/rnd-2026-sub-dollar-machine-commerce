    "settlement_router_stats": {
      "status": "ok",
      "sql": "SELECT COUNT(*) AS n,\n   approx_percentile(CAST(amount AS double)/1e6, 0.10) AS p10,\n   approx_percentile(CAST(amount AS double)/1e6, 0.25) AS p25,\n   approx_percentile(CAST(amount AS double)/1e6, 0.50) AS p50,\n   approx_percentile(CAST(amount AS double)/1e6, 0.75) AS p75,\n   approx_percentile(CAST(amount AS double)/1e6, 0.90) AS p90,\n   AVG(CAST(amount AS double)/1e6) AS mean,\n   STDDEV(CAST(amount AS double)/1e6) AS sd\n   FROM x402x_base.settlementrouter_evt_settled",
      "table_path": "data/real/settlement_router_stats.csv",
      "rows": 1,
      "columns": [
        "n",
        "p10",
        "p25",
        "p50",
        "p75",
        "p90",
        "mean",
        "sd"
      ],
      "sha256": "0a0ec366d122f1aed9e3153dad57c7f0e3f45956bbe2e346faeae9146b245691"
    },
    "settlement_router_buckets": {
      "status": "ok",
      "sql": "SELECT\n   SUM(CASE WHEN CAST(amount AS double)/1e6 < 0.01 THEN 1 ELSE 0 END) AS sub_cent,\n   SUM(CASE WHEN CAST(amount AS double)/1e6 >= 0.01 AND CAST(amount AS double)/1e6 < 0.10 THEN 1 ELSE 0 END) AS c01_10,\n   SUM(CASE WHEN CAST(amount AS double)/1e6 >= 0.10 AND CAST(amount AS double)/1e6 < 1 THEN 1 ELSE 0 END) AS c10_1,\n   SUM(CASE WHEN CAST(amount AS double)/1e6 >= 1 AND CAST(amount AS double)/1e6 < 10 THEN 1 ELSE 0 END) AS c1_10,\n   SUM(CASE WHEN CAST(amount AS double)/1e6 >= 10 THEN 1 ELSE 0 END) AS c10plus,\n   COUNT(*) AS total\n   FROM x402x_base.settlementrouter_evt_settled",
      "table_path": "data/real/settlement_router_buckets.csv",
      "rows": 1,
      "columns": [
        "sub_cent",
        "c01_10",
        "c10_1",
